# ===========================================================================
#  容器编排环境变量模板
#
#   用法：cp .env.example .env  然后按需修改
#
#   【.env 已被根 .gitignore 忽略，绝不入库】
#   这里放的是**示例值**，不是可用密码 —— 生产环境请一律换成随机值。
#   compose 里的写法是 ${VAR:-默认值}，因此不建 .env 也能起来，
#   但那种情况会静默使用 compose 内置的开发默认值（123456 之类），
#   部署到任何能被别人访问的地方之前，务必先建 .env 覆盖。
#
#   另外：不要把这份模板复制到 RuoYi-Vue3/ 目录下。
#   那里已经有 .env.development / .env.production / .env.staging，
#   是 vite 的构建期配置，两者完全不是一回事。
# ===========================================================================

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# 库名要与 backend 的 JDBC URL、以及 SQL 脚本里的库名一致
MYSQL_DATABASE=education_system
# 后端用哪个账号连库（若依默认 root；正式环境建议另建最小权限账号）
MYSQL_USERNAME=root
# 后端也用 root 连库（若依默认），所以这一个变量同时决定 MySQL 与后端
MYSQL_ROOT_PASSWORD=change-me
# 仅本地调试需要暴露；生产请改用 docker-compose.prod.yml（只绑回环）
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Redis（若依强制依赖：验证码、令牌缓存）
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# 后端
# ---------------------------------------------------------------------------
BACKEND_PORT=8080
# JWT 签名密钥。默认值 abcdefghijklmnopqrstuvwxyz 是若依源码里的弱默认值（偏移 D-08），
# 生产必须换成足够长的随机串，否则令牌可被伪造。
# 生成方式（任选）：openssl rand -base64 48   /   python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_SECRET=change-me-to-a-long-random-string
# 容器内存有限，按需调整；-Dfile.encoding=UTF-8 保证中文日志不乱码
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8

# ---------------------------------------------------------------------------
# Druid 监控台（访问路径 /druid）
# ---------------------------------------------------------------------------
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=change-me

# ---------------------------------------------------------------------------
# 前端
# ---------------------------------------------------------------------------
FRONTEND_PORT=80

# ---------------------------------------------------------------------------
# 可选：数据库初始化时追加执行 laboratory_cleanup.sql（界面精简，非清数据）
# 默认关闭，保持与演示数据一致的呈现
# ---------------------------------------------------------------------------
SQL_INCLUDE_CLEANUP=0

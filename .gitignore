# 跨子项目的忽略规则（各子项目另有自己的 .gitignore，两者叠加生效）

######################################################################
# 运行日志与临时输出
*.log
logs/
!**/node_modules/**/*.log

### 后端进程日志（历史遗留，已归档到 .workbuddy/logs/archive/）
backend-run*.log

######################################################################
# 构建产物
target/
dist/
build/
.gradle/
.vite/
*.jar.original
*.war
*.class

# 工具脚本的编译产物（.workbuddy/tools 下的 Java 探针 class 输出）
.workbuddy/tools/t4probe-classes/

######################################################################
# 前端依赖
node_modules/
.pnpm-store/

######################################################################
# IDE / 编辑器
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
*.swp
*.swo
.rebel.xml

######################################################################
# 操作系统
.DS_Store
Thumbs.db
desktop.ini

######################################################################
# WorkBuddy 助手本地产物（记忆与工具脚本保留，日志不入库）
.workbuddy/logs/

######################################################################
# 敏感配置：如需提交请改用环境变量覆盖
# 参考 application.yml 里的 ${RUOYI_DB_PASSWORD:} / ${RUOYI_TOKEN_SECRET:}

######################################################################
# 容器编排的密码文件（docker-compose.yml 从 .env 读取）
# 模板已提交：.env.example
#
# ⚠ 绝不要写成 `.env.*` —— 那个通配符会把 RuoYi-Vue3/.env.development、
#   .env.production、.env.staging 一起忽略掉。那三个是 vite 的**构建期**配置，
#   必须入库，否则前端构建出来的 API 前缀就错了。
#   下面只精确忽略名叫 `.env` 与 `.env.local` 的文件。
.env
.env.local

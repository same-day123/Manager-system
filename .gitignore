# 跨子项目的忽略规则（各子项目另有自己的 .gitignore，两者叠加生效）

######################################################################
# 运行日志与临时输出
*.log
logs/
!**/node_modules/**/*.log

### 后端进程日志（历史遗留，已归档到 .workbuddy/logs/archive/）
backend-run*.log

######################################################################
# 构建产物
target/
dist/
build/
.gradle/
.vite/
*.jar.original
*.war

######################################################################
# 前端依赖
node_modules/
.pnpm-store/

######################################################################
# IDE / 编辑器
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
*.swp
*.swo
.rebel.xml

######################################################################
# 操作系统
.DS_Store
Thumbs.db
desktop.ini

######################################################################
# WorkBuddy 助手本地产物（记忆与工具脚本保留，日志不入库）
.workbuddy/logs/

######################################################################
# 敏感配置：如需提交请改用环境变量覆盖
# 参考 application.yml 里的 ${RUOYI_DB_PASSWORD:} / ${RUOYI_TOKEN_SECRET:}
